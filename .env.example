# =============================================================================
# ForgeCRM — Environment Variable Reference
# =============================================================================
#
# Copy this file to .env and fill in the values for your environment.
# Never commit .env to version control.
#
# Documentation: docs/06_Deployment/606_CONFIGURATION_MANAGEMENT.md
# =============================================================================

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=ForgeCRM
APP_ENV=development
APP_DEBUG=true
APP_VERSION=0.1.0
APP_SECRET_KEY=CHANGE_ME_USE_A_STRONG_RANDOM_SECRET_KEY_AT_LEAST_64_CHARS

# API settings
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
API_CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ── Database (PostgreSQL 17) ──────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=forgecrm
POSTGRES_USER=forgecrm
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# Constructed by the application — set to override
DATABASE_URL=postgresql+asyncpg://forgecrm:CHANGE_ME_STRONG_DB_PASSWORD@postgres:5432/forgecrm

# Test database
TEST_DATABASE_URL=postgresql+asyncpg://forgecrm:CHANGE_ME_STRONG_DB_PASSWORD@postgres:5432/forgecrm_test

# Pool settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_DB=0
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/0

# ── Authentication & JWT ──────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET_KEY=CHANGE_ME_USE_A_STRONG_RANDOM_JWT_SECRET_AT_LEAST_64_CHARS
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Object Storage (MinIO / S3) ───────────────────────────────────────────────
STORAGE_PROVIDER=minio
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY
MINIO_BUCKET=forgecrm
MINIO_SECURE=false

# Production S3 (leave blank in development)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_REGION=us-east-1

# ── Email ─────────────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@forgecrm.io
SMTP_FROM_NAME=ForgeCRM
SMTP_TLS=true

# ── AI Providers ──────────────────────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_DEFAULT_PROVIDER=openai
AI_DEFAULT_MODEL=gpt-4o

# ── Google OAuth (optional) ───────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_INCLUDE_TRACE=false

# ── Frontend (Next.js) ────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=ForgeCRM
NEXT_PUBLIC_APP_VERSION=0.1.0

# ── Docker / Infrastructure ───────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=forgecrm

# MinIO console
MINIO_ROOT_USER=CHANGE_ME_MINIO_ACCESS_KEY
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_SECRET_KEY
